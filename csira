<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kapcsolat — Hazai Kávé Kft.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  :root {
    --espresso: #3D2314;
    --dark-roast: #5C3A2A;
    --accent: #B8860B;
    --accent-light: #D4A84B;
    --cream: #E8D4B8;
    --foam: #F5EBE0;
    --text-dark: #2C1810;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--foam);
    color: var(--text-dark);
    font-family: 'DM Sans', sans-serif;
    line-height: 1.65;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 60px;
    backdrop-filter: blur(24px);
    background: rgba(245,235,224,0.95);
    border-bottom: 1px solid rgba(166,124,82,0.2);
  }
  .nav-logo {
    font-family: 'Unbounded', sans-serif;
    font-weight: 900; font-size: 1.1rem;
    color: var(--accent); text-decoration: none; letter-spacing: -0.03em;
  }
  .nav-logo span { color: var(--text-dark); }
  .nav-links { display: flex; gap: 40px; list-style: none; }
  .nav-links a {
    text-decoration: none; color: var(--text-dark);
    font-size: 0.8rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.15em;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--accent); }
  .hamburger { display: none; }

  @media (max-width: 768px) {
    nav { padding: 18px 24px; }
    .nav-links { display: none; }
    .hamburger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; }
  }

  /* HERO */
  .hero {
    height: 100vh;
    min-height: 780px;
    background: linear-gradient(rgba(44,24,16,0.72), rgba(44,24,16,0.78)), url('https://picsum.photos/id/1015/2000/1200') center/cover no-repeat;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    position: relative;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 40% 30%, rgba(184,134,11,0.28), transparent 75%);
  }
  .hero-content {
    position: relative; z-index: 2; max-width: 920px; padding: 0 20px;
  }
  .hero-eyebrow {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--accent-light); margin-bottom: 16px;
  }
  .hero h1 {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900; line-height: 1.0; letter-spacing: -0.07em;
    color: #fff; margin-bottom: 28px;
  }
  .hero h1 span { color: var(--accent); }
  .hero p { font-size: 1.25rem; color: rgba(255,255,255,0.9); max-width: 620px; margin: 0 auto 48px; }
  .hero-cta {
    background: var(--accent); color: var(--espresso); padding: 20px 48px;
    border-radius: 9999px; font-weight: 700; font-size: 0.95rem;
    text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none;
    transition: all 0.4s cubic-bezier(0.23,1,0.32,1);
  }
  .hero-cta:hover { transform: translateY(-4px) scale(1.05); }

  /* MAP CONTAINER */
  .map-section {
    padding: 120px 20px 100px;
  }
  .map-container {
    max-width: 1380px;
    margin: 0 auto;
    background: white;
    border-radius: 40px;
    overflow: hidden;
    box-shadow: 0 30px 90px rgba(61,35,20,0.25);
    border: 1px solid rgba(184,134,11,0.15);
  }
  .map-header {
    padding: 32px 40px 20px;
    text-align: center;
    border-bottom: 1px solid rgba(166,124,82,0.12);
  }
  .map-header h2 {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.04em;
  }
  #hungary-map {
    height: 620px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .map-container { border-radius: 24px; }
    #hungary-map { height: 520px; }
    .map-section { padding: 80px 16px 80px; }
  }

  /* Region cards */
  .regions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1380px;
    margin: 80px auto 0;
    padding: 0 20px;
  }
  .region-card {
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(184,134,11,0.18);
    border-radius: 28px;
    padding: 28px 24px;
    text-align: center;
    transition: all 0.4s ease;
  }
  .region-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(61,35,20,0.15);
  }

  /* Form */
  .form-section {
    padding: 120px 20px;
    background: var(--espresso);
    color: var(--cream);
  }
  .form-wrapper {
    max-width: 820px;
    margin: 0 auto;
    background: rgba(255,255,255,0.08);
    border-radius: 36px;
    padding: 56px 32px;
    backdrop-filter: blur(16px);
  }
  .submit-btn {
    width: 100%;
    background: var(--accent);
    color: var(--espresso);
    border: none;
    padding: 22px;
    border-radius: 9999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.4s;
  }
  .submit-btn:hover { transform: scale(1.04); }

  footer {
    background: var(--espresso);
    color: var(--cream);
    text-align: center;
    padding: 70px 20px 40px;
    font-size: 0.85rem;
  }
</style>
</head>
<body>

<nav>
  <a href="index.html" class="nav-logo">HAZAI<span>KÁVÉ</span></a>
  <ul class="nav-links">
    <li><a href="index.html">Főoldal</a></li>
    <li><a href="kavegepek.html">Kávégépeink</a></li>
    <li><a href="reklamanyagaink.html">Reklámanyagaink</a></li>
    <li><a href="alapanyagok.html">Alapanyagok</a></li>
    <li><a href="kapcsolat.html" class="active">Kapcsolat</a></li>
  </ul>
  <button class="hamburger" id="hamburger">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="hero">
  <div class="hero-content">
    <div class="hero-eyebrow">ORSZÁGOSAN JELEN VAGYUNK</div>
    <h1>KAPCSOLAT<span>.</span></h1>
    <p>Kattints a térképre • Hívj minket • Ingyenes ajánlat 24 órán belül</p>
    <a href="#map" class="hero-cta">NÉZD MEG A TÉRKÉPET →</a>
  </div>
</div>



<div class="quick-bar" style="background:var(--dark-roast);padding:32px 20px;display:flex;align-items:center;justify-content:center;gap:60px;flex-wrap:wrap;color:var(--cream);font-size:0.95rem;">
  <div style="display:flex;align-items:center;gap:14px;"><span style="font-size:2.1rem;">📍</span><div><strong>Székhely</strong><br><span style="opacity:0.75;">Baja, Budai Nagy Antal u. 36.</span></div></div>
  <div style="display:flex;align-items:center;gap:14px;"><span style="font-size:2.1rem;">✉️</span><div><strong>Email</strong><br><a href="mailto:info@hazaikave.hu" style="color:var(--cream);">info@hazaikave.hu</a></div></div>
  <div style="display:flex;align-items:center;gap:14px;"><span style="font-size:2.1rem;">🕒</span><div><strong>Hétköznap</strong><br><span style="opacity:0.75;">8:00 – 16:00</span></div></div>
</div>

<div id="form" class="form-section">
  <div class="form-wrapper">
    <h2 style="font-family:'Unbounded',sans-serif;font-size:2.5rem;text-align:center;margin-bottom:48px;letter-spacing:-0.04em;color:#fff;">Lépj velünk kapcsolatba!</h2>
    <form id="contactForm">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div style="margin-bottom:24px;"><label style="display:block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;color:var(--cream);">Név *</label><input type="text" id="name" required style="width:100%;background:rgba(255,255,255,0.12);border:1px solid rgba(232,212,184,0.3);border-radius:16px;padding:18px 24px;color:#fff;font-size:1.05rem;"></div>
        <div style="margin-bottom:24px;"><label style="display:block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;color:var(--cream);">Email cím *</label><input type="email" id="email" required style="width:100%;background:rgba(255,255,255,0.12);border:1px solid rgba(232,212,184,0.3);border-radius:16px;padding:18px 24px;color:#fff;font-size:1.05rem;"></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div style="margin-bottom:24px;"><label style="display:block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;color:var(--cream);">Telefonszám</label><input type="tel" id="phone" style="width:100%;background:rgba(255,255,255,0.12);border:1px solid rgba(232,212,184,0.3);border-radius:16px;padding:18px 24px;color:#fff;font-size:1.05rem;"></div>
        <div style="margin-bottom:24px;"><label style="display:block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;color:var(--cream);">Város</label><input type="text" id="city" style="width:100%;background:rgba(255,255,255,0.12);border:1px solid rgba(232,212,184,0.3);border-radius:16px;padding:18px 24px;color:#fff;font-size:1.05rem;"></div>
      </div>
      <div style="margin-bottom:24px;"><label style="display:block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;margin-bottom:8px;color:var(--cream);">Üzenet / Kérés *</label><textarea id="message" required style="width:100%;min-height:160px;background:rgba(255,255,255,0.12);border:1px solid rgba(232,212,184,0.3);border-radius:16px;padding:18px 24px;color:#fff;font-size:1.05rem;resize:vertical;"></textarea></div>
      <button type="submit" class="submit-btn">KÜLDÉS • AJÁNLAT 24 ÓRÁN BELÜL</button>
    </form>
  </div>
</div>

<footer>
  © 2026 Hazai Kávé Kft. — Baja • Minden jog fenntartva.
</footer>

